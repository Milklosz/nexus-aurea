{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velora.local/schemas/velora-playnite-manifest.schema.json",
  "title": "VELORA Playnite Library Manifest",
  "description": "Jawny, tylko do odczytu manifest metadanych eksportowany przez rozszerzenie Playnite i czytany przez VELORA. schemaVersion jest twarda brama kompatybilnosci.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "generatedAt",
    "extension",
    "source",
    "readOnly",
    "games"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Twarda brama kompatybilnosci. Parser v1 akceptuje wylacznie 1."
    },
    "kind": {
      "type": "string",
      "const": "velora.playnite.library-manifest"
    },
    "generatedAt": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "const": "velora-library-exporter" },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "source": {
      "type": "string",
      "const": "playnite-api"
    },
    "readOnly": {
      "type": "boolean",
      "const": true,
      "description": "VELORA nigdy nie zapisuje danych do Playnite."
    },
    "games": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/game" }
    }
  },
  "$defs": {
    "gameId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "isoUtc": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "cover": {
      "type": ["string", "null"],
      "maxLength": 2000000,
      "pattern": "^data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/]+={0,2}$"
    },
    "launch": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": { "type": "string", "const": "playnite-uri" },
        "uri": {
          "type": "string",
          "pattern": "^playnite://playnite/start/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "cover",
        "source",
        "lastPlayed",
        "favorite",
        "installed",
        "launch"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/gameId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "cover": { "$ref": "#/$defs/cover" },
        "source": { "type": "string", "maxLength": 128 },
        "lastPlayed": {
          "anyOf": [{ "$ref": "#/$defs/isoUtc" }, { "type": "null" }]
        },
        "favorite": { "type": "boolean" },
        "installed": { "type": "boolean" },
        "playCount": { "type": "integer", "minimum": 0, "default": 0 },
        "playtimeSeconds": { "type": "integer", "minimum": 0, "default": 0 },
        "launch": { "$ref": "#/$defs/launch" }
      }
    }
  }
}
