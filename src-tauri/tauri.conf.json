{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VELORA",
  "version": "../package.json",
  "identifier": "pl.nexus.aurea",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VELORA",
        "width": 1600,
        "height": 900,
        "minWidth": 780,
        "minHeight": 650,
        "resizable": true,
        "decorations": false,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Entertainment",
    "shortDescription": "VELORA by Milklosh Studio — Grand Cinema",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "VELORA",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
