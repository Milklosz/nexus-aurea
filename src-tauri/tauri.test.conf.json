{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS AUREA Test",
  "identifier": "pl.nexus.aurea.test",
  "app": {
    "appDirectoriesOverride": {
      "config": "$LOCALDATA/NEXUS-AUREA-Test/config",
      "data": "$LOCALDATA/NEXUS-AUREA-Test/data",
      "localData": "$LOCALDATA/NEXUS-AUREA-Test/local",
      "cache": "$LOCALDATA/NEXUS-AUREA-Test/cache",
      "log": "$LOCALDATA/NEXUS-AUREA-Test/logs"
    },
    "windows": [
      {
        "label": "main",
        "title": "NEXUS AUREA Test",
        "width": 1280,
        "height": 800,
        "minWidth": 780,
        "minHeight": 650,
        "resizable": true,
        "decorations": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "NEXUS AUREA Test"
      }
    }
  }
}

